  "faqs": [
    {
      "question": "What do I need to purchase a motorcycle?",
      "answer": "You will mainly need a valid motorcycle license/learner's permit, proof of address, and 3 months of bank statements. There are slight variations in requirements depending on how you plan to pay."
    },
    {
      "question": "Will I need to license my motorcycle myself?",
      "answer": "You may complete licensing yourself, or we can assist you with the process. Skip the queues and simply select 'licensing' as an add-on to your purchase with us."
    },
    {
      "question": "Do you offer financing options?",
      "answer": "You may apply for private finance or finance through your company. These require different applications and documentation."
    },
    {
      "question": "Do you take trade-ins?",
      "answer": "We do accept trade-ins for eligible motorcycles. Please contact us for more information and to discuss the details of your trade-in."
    },
    {
      "question": "Do I have to have a motorcycle license to purchase a motorcycle?",
      "answer": "A valid motorcycle license is required if you choose to finance. Cash purchases do not require a license."
    },
    {
      "question": "How long is the warranty on a new motorcycle?",
      "answer": "Our new motorcycles come with a standard manufacturer's warranty that typically covers your bike for a period of two years from the date of purchase."
    }
  ]
